# Template file for 'kernel-neko-liquorix'
pkgname=linux-neko-liquorix
version=7.3.0
revision=1
short_desc="Liquorix kernel and modules for Neko Void Linux"
maintainer="JavierC"
license="GPL-2.0-only"
homepage="https://liquorix.net/"
archs="x86_64*"

# The archive is produced by .github/workflows/liquorix.yml.
distfiles="https://github.com/Neko-Void-Linux/kernel-neko-void/releases/download/latest/liquorix-kernel-void-${version}-liquorix-neko%2B.tar.gz"
checksum="33c06672b9346fd4f625b0258371b901d769ce160dcdd4af09fb9dc908f15ed9"
create_wrksrc=yes

depends="dracut kmod"
triggers="kernel-hooks"
kernel_hooks_version="${version}-liquorix-neko+"

do_install() {
	vmkdir boot
	vmkdir usr/lib/modules
	vmkdir usr/src

	cp -a boot/. ${DESTDIR}/boot/
	cp -a lib/modules/. ${DESTDIR}/usr/lib/modules/
	if [ -d usr/src ]; then
		cp -a usr/src/. ${DESTDIR}/usr/src/
	fi
}
